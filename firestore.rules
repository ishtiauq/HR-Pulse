rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Companies collection
    match /companies/{adminUid}/snapshots/{document=**} {
      // Allow the Admin to read and write their own company's data.
      // Note: In this MVP, employees log in via a fallback mechanism or custom token.
      // If employees are authenticated via Firebase Auth in the future, you would add their authorization here.
      allow read, write: if request.auth != null && request.auth.uid == adminUid;
    }
  }
}
